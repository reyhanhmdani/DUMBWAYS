-- melihat data users yang sudah terhubung ke relasi lainnya (query pada umumnya)
SELECT 
    users.name AS nama_user,
    projects.title AS nama_proyek,
    tech.name AS nama_teknologi
FROM users
-- 1. Hubungkan user ke project
JOIN projects ON users.id = projects.user_id
-- 2. Hubungkan project ke junction (Gunakan alias 'pt' secara konsisten)
JOIN project_tech pt ON projects.id = pt.project_id
-- 3. Hubungkan junction ke master teknologi
JOIN tech ON pt.tech_id = tech.id;


-- query menampilkan tech nya itu sebaris dengan array langsung dengan memakai json_agg
select 
	users.name as nama_user,
	projects.title as nama_proyek,
	json_agg(tech.name) as nama_teknologi
from users
join projects on users.id = projects.user_id
join project_tech on projects.id = project_tech.project_id
join tech on project_tech.tech_id = tech.id
group by users.id, projects.id;

-- cara baca code atas
1. FROM users
"Mulai dari tabel users sebagai data utama."
2. JOIN projects ON users.id = projects.user_id
"Gabungkan dengan tabel projects, caranya: cocokkan id di users dengan user_id di projects. Jadi setiap user berpasangan dengan project miliknya."
3. JOIN project_tech ON projects.id = project_tech.project_id
"Gabungkan lagi dengan tabel project_tech (junction table). Cocokkan id di projects dengan project_id di project_tech."
4. JOIN tech ON project_tech.tech_id = tech.id
"Gabungkan lagi dengan tabel tech. Cocokkan tech_id di project_tech dengan id di tech. Sekarang kita tahu nama teknologi-nya."
Sampai sini, database sudah punya "tabel raksasa gabungan" dari 4 tabel.
5. GROUP BY users.id, projects.id
"Kelompokkan hasilnya berdasarkan per user dan per project. Jadi kalau satu project pakai 3 tech, itu dianggap 1 kelompok."
6. SELECT ... json_agg(tech.name) ...
"Dari kelompok-kelompok tadi, ambil: nama user, nama project, dan kumpulkan semua nama tech dalam satu kelompok menjadi satu array JSON."

